{
  "name": "hich-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:react": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender.mjs",
    "build:cloudflare": "npm run build && node scripts/prepare-cloudflare.mjs",
    "preview": "vite preview",
    "preview:cloudflare": "npm run build:cloudflare && wrangler dev",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "test": "node scripts/qa.mjs",
    "test:chat-server": "node scripts/test-chat-server.mjs",
    "test:chat-unit": "node scripts/test-assistant-knowledge.mjs && node scripts/test-chat-reveal.mjs && node scripts/test-chat-server.mjs && node scripts/test-cloudflare-worker.mjs",
    "test:experiences": "node scripts/qa-experiences.mjs",
    "test:chat": "node scripts/qa-chat.mjs",
    "zip": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.52.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "6.1.0",
    "archiver": "^8.0.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "vite": "8.2.2",
    "wrangler": "4.151.2"
  }
}
