# Server only. Copy to .env.local for development. Never use a VITE_ prefix.
# Leave empty to use the built-in website guide without external AI requests.
GEMINI_API_KEY=
# The hybrid router uses Gemini only for complex HICH project synthesis.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=1600
# low balances reasoning quality, speed and token use. Supported values:
# minimal, low, medium, high.
GEMINI_THINKING_LEVEL=low
