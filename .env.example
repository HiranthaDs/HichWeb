# Server-only AI configuration. Copy to .env.local for development. Never use
# a VITE_ prefix for secret values such as API keys.
# Leave empty to use the built-in website guide without external AI requests.
GEMINI_API_KEY=
# Relevant HICH/project/terms questions try Gemini grounded in local knowledge.
# Quota, output limits or provider failures fall back to the built-in guide.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=800
# The server clamps this allowance to 256..1000 tokens; replies use <=150 words.
# minimal keeps the reasoning budget small. Supported values:
# minimal, low, medium, high.
GEMINI_THINKING_LEVEL=minimal

# Optional Search Console HTML-tag verification token. A Domain property should
# normally be verified with DNS instead. This value is public, not a secret.
GOOGLE_SITE_VERIFICATION=
